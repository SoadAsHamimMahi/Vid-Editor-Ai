# Google Gemini API Key (Used for Script Parsing, Visual Prompts, Google TTS)
GEMINI_API_KEY=

# Groq API Key (Fast LLM Director & Whisper Transcription)
GROQ_API_KEY=

# ElevenLabs API Key (Premium Voices)
ELEVENLABS_API_KEY=

# OpenAI API Key (ChatGPT / Whisper TTS)
OPENAI_API_KEY=

# Optional Colab Tunnel URL for Wan2.1 / LTX-Video generation
# COLAB_TUNNEL_URL=https://xxxx.gradio.live
