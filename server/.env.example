# ==============================================================================
# CineFlow Studio API Server — Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit your actual .env file to Git!
# ==============================================================================

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cineflow?schema=public

# ─── Redis (Sessions, Rate Limiting, Job Queue) ──────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ──────────────────────────────────────
# Generate RS256 key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Or use HS256 symmetric secret (simpler for development):
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Stripe (Billing & Subscriptions) ────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_CREATOR_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=CineFlow Studio <no-reply@cineflow.studio>

# ─── Server ───────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:3001
WEBSITE_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── File Storage (Cloudflare R2 / S3) ───────────────────────
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_BUCKET=cineflow-releases
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://cdn.cineflow.studio

# ─── AI API Keys (Server-Side Proxy) ─────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ─── Super Admin Seed ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@cineflow.studio
SEED_ADMIN_PASSWORD=change-me-immediately
SEED_ADMIN_NAME=Super Admin
